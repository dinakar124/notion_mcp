# Notion MCP Server — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# === Notion OAuth (required for real-provider mode) ===
NOTION_CLIENT_ID=your_oauth_client_id_here
NOTION_CLIENT_SECRET=your_oauth_client_secret_here
NOTION_REDIRECT_URI=http://localhost:3000/oauth/callback

# === Notion Test Workspace (required for contract tests) ===
NOTION_TEST_WORKSPACE_TOKEN=your_internal_integration_token_here
NOTION_TEST_WORKSPACE_ID=your_workspace_id_here
NOTION_TEST_PARENT_PAGE_ID=share_a_page_with_your_integration_and_put_its_id_here

# === Webhook Verification ===
NOTION_WEBHOOK_VERIFICATION_TOKEN=your_webhook_verification_token_here

# === PostgreSQL ===
DATABASE_URL=postgresql://notion_mcp:notion_mcp_dev@localhost:5432/notion_mcp
POSTGRES_USER=notion_mcp
POSTGRES_PASSWORD=notion_mcp_dev
POSTGRES_DB=notion_mcp

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Server ===
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=127.0.0.1
NODE_ENV=development

# === Encryption (showcase: local key; production: KMS) ===
ENCRYPTION_MASTER_KEY=generate_a_256_bit_key_for_local_dev

# === External IdP ===
IDP_ISSUER=https://your-idp.example.com
IDP_AUDIENCE=notion-mcp-server
IDP_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=notion-mcp

# === Test JWKS Issuer (local dev) ===
JWKS_ISSUER_PORT=3001
JWKS_ISSUER_HOST=127.0.0.1

# === Notion Fake (local dev) ===
NOTION_FAKE_PORT=3002
NOTION_FAKE_HOST=127.0.0.1
