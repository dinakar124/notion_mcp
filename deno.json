{
  "version": "0.1.0",
  "name": "@notion-mcp/server",
  "exports": "./src/main.ts",
  "tasks": {
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "lint": "deno lint src/ tests/ test-support/",
    "fmt:check": "deno fmt --check src/ tests/ test-support/ migrations/",
    "fmt": "deno fmt src/ tests/ test-support/ migrations/",
    "test": "deno test --allow-read --allow-env tests/unit/ && deno test test-support/notion-fake/server_test.ts test-support/jwks-issuer/server_test.ts && deno test --allow-net=127.0.0.1 tests/integration/ && deno task test:smoke",
    "test:unit": "deno test --allow-read --allow-env tests/unit/",
    "test:support": "deno test test-support/notion-fake/server_test.ts test-support/jwks-issuer/server_test.ts",
    "test:smoke": "deno test --allow-run=deno --allow-read --allow-net=127.0.0.1 tests/smoke/",
    "test:integration": "deno test --allow-net=127.0.0.1 tests/integration/",
    "test:conformance": "deno test --allow-read --allow-env --allow-net=localhost tests/conformance/",
    "test:contract": "deno test --allow-read --allow-env --allow-net=api.notion.com tests/contract/",
    "dev": "deno run --watch --allow-env=MCP_SERVER_HOST,MCP_SERVER_PORT,MCP_ALLOWED_ORIGINS,MCP_ALLOW_NON_LOOPBACK,LOG_LEVEL,NOTION_MODE,NOTION_TOKEN,NOTION_API_BASE_URL,NOTION_API_VERSION,NOTION_TIMEOUT_MS --allow-net=127.0.0.1,localhost src/main.ts",
    "dev:real": "deno run --watch --allow-env=MCP_SERVER_HOST,MCP_SERVER_PORT,MCP_ALLOWED_ORIGINS,MCP_ALLOW_NON_LOOPBACK,LOG_LEVEL,NOTION_MODE,NOTION_TOKEN,NOTION_API_BASE_URL,NOTION_API_VERSION,NOTION_TIMEOUT_MS --allow-net=127.0.0.1,localhost,api.notion.com src/main.ts",
    "start": "deno run --allow-env=MCP_SERVER_HOST,MCP_SERVER_PORT,MCP_ALLOWED_ORIGINS,MCP_ALLOW_NON_LOOPBACK,LOG_LEVEL,NOTION_MODE,NOTION_TOKEN,NOTION_API_BASE_URL,NOTION_API_VERSION,NOTION_TIMEOUT_MS --allow-net=127.0.0.1,localhost src/main.ts",
    "build": "deno compile --allow-read --allow-env --allow-net src/main.ts",
    "spike": "deno run --allow-read --allow-env --allow-net=127.0.0.1,localhost tests/spike/compatibility-spike.ts",
    "spike:sdk": "deno run --allow-read --allow-env --allow-net=127.0.0.1,localhost tests/spike/compatibility-spike.ts --sdk-only",
    "spike:probe": "deno run --allow-read --allow-env --allow-net=127.0.0.1,localhost tests/spike/compatibility-spike.ts --probe",
    "spike:adapter": "deno run --allow-net=127.0.0.1,localhost tests/spike/mcp-2026-adapter-spike.ts",
    "spike:otel": "deno test '--allow-env=OTEL_*' tests/spike/otel-spike.ts",
    "tools:install": "sh tooling/scanners/install-scanners.sh",
    "scan:secrets": "sh tooling/scanners/scan-secrets.sh",
    "scan:fs": ".tools/bin/trivy filesystem --scanners vuln,secret,misconfig --severity CRITICAL,HIGH --exit-code 1 --skip-dirs .git --skip-dirs node_modules --skip-dirs tooling/mutation/node_modules --skip-dirs .tools --skip-dirs stryker-tmp --skip-files .env .",
    "sbom": ".tools/bin/syft scan dir:. --exclude ./.git --exclude ./.tools --exclude ./.env --exclude ./node_modules --exclude ./tooling/mutation/node_modules --exclude ./stryker-tmp -o cyclonedx-json=sbom.cdx.json",
    "actionlint": "PATH=\".tools/bin:$PATH\" .tools/bin/actionlint .github/workflows/pr-ci.yml .github/workflows/contract-ci.yml",
    "test:rewards": "deno test --allow-read tests/rewards/",
    "test:mutation:tooling": "node ./tooling/mutation/node_modules/.bin/stryker run stryker.config.mjs"
  },
  "imports": {
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.3.1",
    "@modelcontextprotocol/core": "npm:@modelcontextprotocol/core@2.3.1",
    "@notionhq/client": "npm:@notionhq/client@5.27.0",
    "postgres": "npm:postgres@3.4.5",
    "ioredis": "npm:ioredis@5.6.1",
    "zod": "npm:zod@4.6.5",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0",
    "@opentelemetry/sdk-trace-base": "npm:@opentelemetry/sdk-trace-base@2.12.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@2.12.0",
    "@opentelemetry/context-async-hooks": "npm:@opentelemetry/context-async-hooks@2.12.0",
    "fast-check": "npm:fast-check@3.23.2",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing": "jsr:@std/testing@1.0.21"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["node_modules/", "*.gen.ts"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "nodeModulesDir": "auto"
}
